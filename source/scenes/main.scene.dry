title: Next month
set-bg: img/Athens.png
is-hand: true
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Students - an action is available.';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Students - next action available in 1 month.';
} else {
    Q.pinnedCardsDescription = 'Students - next action available in ' + Q.advisor_action_timer + ' months.';
}
!}
max-cards: 2

# Here, the main deck will be displayed. Clicking on the deck draws a card into your hand. Clicking on a card activates that card.

- @party
- @govt
- #advisor
- @shuffle_leadership_pinned

@party
title: Personal Affairs
card-image: img/PA.png
is-deck: true

- #party_affairs

@govt
title: Trial
view-if: time >= 6
card-image: img/reichstag_2.jpg
is-deck: true

- #govt_affairs

@philo
title: Philosophy
card-image: 
is-deck: true

- #philo_affairs
